# ZERO - Environment Variables Example
# Copie para .env e preencha com valores seguros

# ===========================================================================
# GERAL
# ===========================================================================
NODE_ENV=development
PORT=3000

# ===========================================================================
# DATABASE (PostgreSQL)
# ===========================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zero
DB_USER=zero_admin
DB_PASSWORD=CHANGE_THIS_PASSWORD_IN_PRODUCTION_123456789
DATABASE_URL=postgresql://zero_admin:CHANGE_THIS_PASSWORD_IN_PRODUCTION_123456789@localhost:5432/zero

# ===========================================================================
# REDIS
# ===========================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD_IN_PRODUCTION_123456789
REDIS_URL=redis://:CHANGE_THIS_REDIS_PASSWORD_IN_PRODUCTION_123456789@localhost:6379

# ===========================================================================
# MINIO / S3 Object Storage
# ===========================================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=zero_access_key_change_this
MINIO_SECRET_KEY=zero_secret_key_change_this_in_production_123456789
MINIO_BUCKET=documents
MINIO_USE_SSL=false

# ===========================================================================
# JWT & SESSIONS
# ===========================================================================
JWT_SECRET=CHANGE_THIS_JWT_SECRET_IN_PRODUCTION_MIN_32_CHARS_1234567890abcdef
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_ROTATION_ENABLED=true

# ===========================================================================
# CRIPTOGRAFIA
# ===========================================================================
# Chave mestra para envelope encryption (32 bytes hex)
ENCRYPTION_MASTER_KEY=CHANGE_THIS_32_BYTE_HEX_KEY_IN_PRODUCTION_0123456789abcdef0123456789abcdef

# Argon2id parameters
ARGON2_MEMORY_SIZE=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ===========================================================================
# SEGURANÇA
# ===========================================================================
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
MFA_MAX_ATTEMPTS=3
BIOMETRIC_MAX_ATTEMPTS=3

# Rate limiting (requests por minuto)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3001
CORS_CREDENTIALS=true

# ===========================================================================
# LOGGING & AUDITORIA
# ===========================================================================
LOG_LEVEL=debug
AUDIT_LOG_ENABLED=true
AUDIT_LOG_SENSITIVE_ACTIONS=true

# ===========================================================================
# BACKUP & RECUPERAÇÃO
# ===========================================================================
BACKUP_ENCRYPTION_KEY=CHANGE_THIS_BACKUP_KEY_IN_PRODUCTION_0123456789abcdef
BACKUP_S3_BUCKET=backups
BACKUP_RETENTION_DAYS=30

# ===========================================================================
# WEB AUTHN / PASSKEYS
# ===========================================================================
WEBAUTHN_RP_NAME=ZERO Security Center
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3001

# ===========================================================================
# NOTIFICAÇÕES (futuro)
# ===========================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=change_this_smtp_password
NOTIFICATION_FROM=noreply@example.com

# ===========================================================================
# MONITORAMENTO (futuro)
# ===========================================================================
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
