# ZERO - Environment Variables Template
# 
# COPIE ESTE ARQUIVO PARA .env.docker E PREENCHA OS VALORES
# NUNCA commitar .env com secrets reais

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
POSTGRES_USER=zero_dev
POSTGRES_PASSWORD=CHANGE_THIS_IN_PRODUCTION_USE_STRONG_PASSWORD
POSTGRES_DB=zero
POSTGRES_PORT=5432
DATABASE_URL=postgresql://zero_dev:CHANGE_THIS_IN_PRODUCTION_USE_STRONG_PASSWORD@localhost:5432/zero

# =============================================================================
# REDIS
# =============================================================================
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD_USE_STRONG_RANDOM
REDIS_PORT=6379
REDIS_URL=redis://:CHANGE_THIS_REDIS_PASSWORD_USE_STRONG_RANDOM@localhost:6379

# =============================================================================
# MINIO (S3-compatible storage)
# =============================================================================
MINIO_ROOT_USER=minioadmin_dev
MINIO_ROOT_PASSWORD=CHANGE_THIS_MINIO_PASSWORD_USE_STRONG_RANDOM
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_BACKUPS=backups

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# =============================================================================
# AUTHENTICATION & SESSIONS
# =============================================================================
# Gerar com: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_JWT_SECRET_USE_32_BYTES_RANDOM
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Gerar com: openssl rand -base64 32  
SESSION_SECRET=CHANGE_THIS_SESSION_SECRET_USE_32_BYTES_RANDOM

# =============================================================================
# ENCRYPTION KEYS
# =============================================================================
# Master key para envelope encryption (32 bytes em base64)
# Gerar com: openssl rand -base64 32
MASTER_KEY=CHANGE_THIS_MASTER_KEY_USE_32_BYTES_RANDOM
MASTER_KEY_ID=mk_dev_001

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=900000

# =============================================================================
# SECURITY
# =============================================================================
BCRYPT_ROUNDS=12
ARGON2_MEMORY_SIZE=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=debug
LOG_FORMAT=json

# =============================================================================
# CORS (desenvolvimento)
# =============================================================================
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# =============================================================================
# FILE UPLOADS
# =============================================================================
MAX_FILE_SIZE=104857600
UPLOAD_DIR=/tmp/uploads
