{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "baseUrl": ".",
    "paths": {
      "@zero/auth": ["packages/auth/src/index.ts"],
      "@zero/crypto": ["packages/crypto/src/index.ts"],
      "@zero/security": ["packages/security/src/index.ts"],
      "@zero/database": ["packages/database/src/index.ts"],
      "@zero/shared": ["packages/shared/src/index.ts"],
      "@zero/storage": ["packages/storage/src/index.ts"],
      "@zero/audit": ["packages/audit/src/index.ts"]
    },
    "types": ["node"]
  },
  "exclude": ["node_modules", "dist", "build", ".next", "coverage"]
}
